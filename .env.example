# ==========================================================================
# Afia Food Hub — Environment Configuration Template
# ==========================================================================
# Copy this file to `.env` (backend) or `frontend/.env` (frontend) and
# replace every placeholder with a real value.
#
#   cp .env.example backend/.env
#   cp .env.example frontend/.env    # then keep only the REACT_APP_* block
#
# !! NEVER commit a real .env file. This template must contain placeholders
# !! only. The repository's .gitignore excludes .env* but explicitly
# !! re-includes .env.example.
# ==========================================================================


# ==========================================================================
# BACKEND / API  (backend/.env)
# ==========================================================================

# --- Runtime ---------------------------------------------------------------
# development | production | test
NODE_ENV=development

# Port used when running the Express app directly (npm run dev).
# Ignored on Vercel, where the platform assigns the port.
PORT=5000

# Set to 1 behind a proxy (Vercel, Render, Nginx) so client IPs and
# rate limiting see the real address instead of the proxy's.
TRUST_PROXY=1

# --- Database (Neon / PostgreSQL) ------------------------------------------
# POOLED connection string — use this everywhere in the running application.
# Neon pooler host ends with "-pooler" and the URL contains "-pooler".
# Example: postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/DB?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/afia_food_hub?sslmode=require

# DIRECT connection string — use this ONLY for migrations and schema work.
# It bypasses the pooler. Never use it from a serverless function.
# Example: postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/afia_food_hub?sslmode=require
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/afia_food_hub?sslmode=require

# Reject unauthorized TLS certificates in production. Keep "true" on Neon.
DATABASE_SSL=true

# --- Security --------------------------------------------------------------
# Generate with:  openssl rand -base64 48
# MUST be at least 32 bytes. Rotate before going live.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES_LONG

# Separate secret for refresh tokens. Generate a different value.
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET_AT_LEAST_32_BYTES_LONG

# Access token lifetime (seconds). Default 15 minutes.
JWT_EXPIRES_IN=900

# Refresh token lifetime (seconds). Default 7 days.
JWT_REFRESH_EXPIRES_IN=604800

# Bcrypt cost factor. 12 is a good balance. Minimum 10.
BCRYPT_ROUNDS=12

# Minimum password length enforced at signup and password change.
PASSWORD_MIN_LENGTH=8

# --- CORS / Allowed origins ------------------------------------------------
# Comma-separated list of origins permitted to call the API.
# The Vercel production domain, the local dev server, and any preview
# deployment hosts you want to allow. Never use "*" with credentials.
# Example: https://afia-food-hub.vercel.app,http://localhost:3000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Session / cookies -----------------------------------------------------
# Leave the domain empty for localhost and for apex-domain deployments.
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Rate limiting ---------------------------------------------------------
# Failed login attempts allowed per account before a temporary lockout.
LOGIN_MAX_ATTEMPTS=10
# Window for the attempt counter, in minutes.
LOGIN_WINDOW_MINUTES=15
# Lockout duration once the limit is exceeded, in minutes.
LOGIN_LOCKOUT_MINUTES=15
# Signup attempts allowed per IP per hour.
SIGNUP_MAX_ATTEMPTS_PER_HOUR=5

# --- Business configuration ------------------------------------------------
# Currency code used for all monetary values.
CURRENCY=GHS

# Default delivery fee in GHS. The server is the authority on this value.
DELIVERY_FEE=5.00

# Free-delivery threshold in GHS. 0 disables free delivery.
FREE_DELIVERY_THRESHOLD=0

# Delivery zones the kitchen serves (comma-separated). Display only.
DELIVERY_ZONES=Accra

# Minimum order value in GHS for an order to be accepted.
MIN_ORDER_VALUE=0

# --- Uploads / object storage ----------------------------------------------
# Driver for menu item images: neon | vercel | local
# "local" writes to disk and is ONLY valid for local development.
UPLOAD_DRIVER=local
UPLOAD_BUCKET=afia-food-hub-assets
# Public base URL that uploaded files are served from.
UPLOAD_PUBLIC_URL=
# Maximum accepted upload size in bytes (5 MB).
UPLOAD_MAX_BYTES=5242880

# --- Payments --------------------------------------------------------------
# Provider: paystack | hubtel | disabled
# "disabled" hides all online payment options and offers Cash on Delivery only.
# The application never simulates a successful payment.
PAYMENT_PROVIDER=disabled

# Paystack (supports MTN MoMo, Telecel Cash, AirtelTigo Money and cards in Ghana)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Secret used to verify webhook signatures. Must match the dashboard value.
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_API_BASE=https://api.paystack.co

# Hubtel (alternative provider)
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ID=
HUBTEL_API_BASE=https://api.hubtel.com

# Merchant details shown in mobile-money prompts.
PAYMENT_MERCHANT_NAME=Afia Food Hub
PAYMENT_MERCHANT_PHONE=

# --- Notifications / email -------------------------------------------------
# Provider: resend | smtp | none
EMAIL_PROVIDER=none
EMAIL_FROM=Afia Food Hub <no-reply@example.com>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- AI assistant (chatbot) ------------------------------------------------
# Provider: none | neon-ai-gateway | openai
# With "none", the assistant answers only from the live menu API and
# says so plainly when it does not know something. It never invents data.
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
AI_API_BASE=

# --- Logging ---------------------------------------------------------------
# error | warn | info | debug
LOG_LEVEL=info
# Emit JSON logs (recommended for Vercel) instead of pretty-printed logs.
LOG_JSON=true

# --- Health / ops ----------------------------------------------------------
# Value reported by GET /api/health
APP_VERSION=1.0.0
# Public URL of the deployed frontend, used in emails and OG tags.
PUBLIC_APP_URL=http://localhost:3000
# Support contact shown in the footer, emails and receipts.
SUPPORT_PHONE=
SUPPORT_EMAIL=
BUSINESS_ADDRESS=
BUSINESS_HOURS=Mon-Sat 6:00 AM - 11:00 PM


# ==========================================================================
# FRONTEND  (frontend/.env)
# ==========================================================================
# These are the only variables the CRA build exposes. Anything prefixed
# with REACT_APP_ is compiled into the JavaScript bundle and is therefore
# PUBLIC. Never put a secret behind a REACT_APP_ name.
# ==========================================================================

# Base URL of the API, including the /api path.
# Development : http://localhost:5000/api
# Production  : https://afia-food-hub.vercel.app/api
REACT_APP_API_URL=http://localhost:5000/api

# Brand name shown in the UI. Rarely needs changing.
REACT_APP_BRAND_NAME=Afia Food Hub
